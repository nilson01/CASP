.DS_Store
__pycache__/
*.py[cod]
*.log
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
.venv/
venv/

# Raw and processed MovieLens data are regenerated locally.
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# Large or local rerun artifacts.
outputs/logs/*
outputs/manifests/*.json
outputs/**/task_results/
outputs/**/logs/
outputs/**/cache/
outputs/**/raw/

# Keep small reported CSV/TeX/SVG assets unless intentionally removed.
!outputs/tables/**/*.csv
!outputs/tables/**/*.tex
!outputs/figures/**/*.csv
!outputs/figures/**/*.svg
!outputs/manifests/**/*.csv
